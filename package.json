{
  "name": "evalkit",
  "version": "0.4.0",
  "description": "Turn real-world bugs and AI agent failure states in any git repo into reproducible, verified eval environments.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhilashi/evalkit.git"
  },
  "homepage": "https://github.com/abhilashi/evalkit#readme",
  "bugs": {
    "url": "https://github.com/abhilashi/evalkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "evalkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "ai",
    "evals",
    "benchmarks",
    "rl-environments",
    "coding-agents",
    "agent-skill",
    "swe-bench"
  ],
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
